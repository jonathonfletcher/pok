clusterRole:
  create: true
  rules:
  - apiGroups:
    - ""
    resources:
    - nodes/proxy
    verbs:
    - get
config:
  exporters:
    otlp_http:
      endpoint: https://api.honeycomb.io:443
      headers:
        x-honeycomb-team: $${env:HONEYCOMB_API_KEY}
    otlp_http/k8s-logs:
      endpoint: https://api.honeycomb.io:443
      headers:
        x-honeycomb-dataset: k8s-logs
        x-honeycomb-team: $${env:HONEYCOMB_API_KEY}
    otlp_http/k8s-metrics:
      endpoint: https://api.honeycomb.io:443
      headers:
        x-honeycomb-dataset: k8s-metrics
        x-honeycomb-team: $${env:HONEYCOMB_API_KEY}
  processors:
    # Stamp the provider/cluster identity on every signal so both clusters that report into
    # this Honeycomb environment are distinguishable (rendered per provider via templatefile).
    resource/cluster:
      attributes:
        - key: k8s.cluster.name
          value: ${k8s_cluster_name}
          action: upsert
    # Metric allowlist — keep ONLY the metrics the dashboards + cost apps use; drop the rest of the
    # kubeletstats firehose (per-container cpu/mem/fs, page-faults, rss, network, uptime, absolute
    # limits/requests, ...). This pipeline also carries the cost apps' OTLP metrics, so aws/azure
    # cost + credentials_ok are explicitly kept. NOTE: the k8s_cluster receiver's metrics
    # (deployments/daemonsets/namespaces/node-readiness) come from the SEPARATE cluster collector
    # and are unaffected by this agent-side filter.
    filter/allowlist:
      error_mode: ignore
      metrics:
        include:
          match_type: regexp
          metric_names:
            - ^k8s\.pod\.cpu\.usage$
            - ^k8s\.pod\.memory\.working_set$
            - ^k8s\.pod\.cpu_limit_utilization$
            - ^k8s\.pod\.memory_limit_utilization$
            - ^k8s\.node\.cpu\.usage$
            - ^k8s\.node\.memory\.usage$
            - ^k8s\.node\.memory\.working_set$
            - ^k8s\.node\.condition_ready$
            - ^k8s\.container\.restarts$
            - ^(aws|azure)\.cost\.
            - \.poller\.credentials_ok$
  receivers:
    jaeger: null
    kubeletstats:
      collection_interval: 1800s # 30m — radically cut metric datapoint volume (~60x vs 30s)
      insecure_skip_verify: true
      metric_groups:
      - node
      - pod
      - container   # per-container metrics (container.memory.usage/working_set) for split-sizing multi-container pods
      metrics:
        k8s.node.uptime:
          enabled: true
        k8s.pod.cpu_limit_utilization:
          enabled: true
        k8s.pod.cpu_request_utilization:
          enabled: true
        k8s.pod.memory_limit_utilization:
          enabled: true
        k8s.pod.memory_request_utilization:
          enabled: true
        k8s.pod.uptime:
          enabled: true
        # Per-container utilization (default off) — lets multi-container pods like the Kafka
        # entity-operator (topic-operator + user-operator) be split-sized. The raw usage series
        # (container.memory.usage / container.memory.working_set) arrive with the container group.
        k8s.container.cpu_limit_utilization:
          enabled: true
        k8s.container.cpu_request_utilization:
          enabled: true
        k8s.container.memory_limit_utilization:
          enabled: true
        k8s.container.memory_request_utilization:
          enabled: true
    zipkin: null
  service:
    pipelines:
      logs:
        exporters:
        - otlp_http/k8s-logs
        processors:
        - k8s_attributes
        - memory_limiter
        - resource/cluster
        - batch
      metrics:
        exporters:
        - otlp_http/k8s-metrics
        processors:
        - k8s_attributes
        - memory_limiter
        - resource/cluster
        - filter/allowlist
        - batch
        receivers:
        - kubeletstats
        - otlp   # accept OTLP metrics pushed to the node-local agent (e.g. apps/awscost); otlp receiver comes from chart defaults
      traces:
        exporters:
        - otlp_http
        processors:
        - k8s_attributes
        - memory_limiter
        - resource/cluster
        - batch
        receivers:
        - otlp
extraEnvs:
- name: HONEYCOMB_API_KEY
  valueFrom:
    secretKeyRef:
      key: api-key
      name: honeycomb
image:
  repository: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-k8s
mode: daemonset
ports:
  jaeger-compact:
    enabled: false
  jaeger-grpc:
    enabled: false
  jaeger-thrift:
    enabled: false
  zipkin:
    enabled: false
presets:
  kubeletMetrics:
    enabled: true
  kubernetesAttributes:
    enabled: true
    extractAllPodAnnotations: true
    extractAllPodLabels: true
resources:
  limits:
    memory: 512Mi
  requests:
    cpu: 100m
    memory: 128Mi
tolerations:
- effect: NoSchedule
  key: node-role.kubernetes.io/control-plane
  operator: Exists
