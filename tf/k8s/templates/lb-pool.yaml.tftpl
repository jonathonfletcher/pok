# GENERATED by tf/k8s (tofu) from this template — do not edit the rendered lb-pool.yaml.
# Cilium external-access layer — a single LoadBalancer IP pool (BGP-advertised).
#
# kubectl-applied by `make services` right after the Cilium Helm release. One IP
# (${lb_pool_prefix}.240) in the routed ${lb_pool_prefix}.0/24 prefix the provider's router
# sends to the nodes via BGP; Cilium advertises the assigned VIP as a /32 (bgp.yaml). The
# serviceSelector excludes Strimzi Services — Kafka is internal-only (no LB), and this keeps a
# future broker LB from taking .240.
#
#   apps-pool  .240   -> non-Strimzi Services (edge takes .240)
---
apiVersion: cilium.io/v2
kind: CiliumLoadBalancerIPPool
metadata:
  name: apps-pool
spec:
  disabled: false
  blocks:
    - start: "${lb_pool_prefix}.240"
      stop: "${lb_pool_prefix}.240"
  serviceSelector:
    matchExpressions:
      - { key: strimzi.io/cluster, operator: DoesNotExist }
