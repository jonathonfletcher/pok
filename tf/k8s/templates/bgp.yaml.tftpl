# GENERATED by tf/k8s (tofu) from this template — do not edit the rendered bgp.yaml.
# Cilium BGP control plane (BGPv2, apiVersion cilium.io/v2 as of Cilium 1.19).
#
# All Linux nodes (AS ${bgp_local_asn}) peer eBGP with the provider's router
# ${bgp_peer_address} (AS ${bgp_peer_asn}) and advertise every LoadBalancer VIP (/32)
# from the ${lb_pool_prefix}.0/24 pool — the L3 replacement for L2/ARP, so the same
# model works on any provider (bhyve: OpenBSD bgpd; aws: FRR on the border). Multiple
# nodes advertising the same VIP give the router ECMP paths = failover.
#
# kubectl-applied by `make services` after Cilium registers the BGP CRDs (same
# single-pass pattern as lb-pool.yaml).
---
apiVersion: cilium.io/v2
kind: CiliumBGPClusterConfig
metadata:
  name: ${bgp_cluster_name}
spec:
  nodeSelector:
    matchLabels:
      kubernetes.io/os: linux # every node peers
  bgpInstances:
    - name: "instance-${bgp_local_asn}"
      localASN: ${bgp_local_asn}
      peers:
        - name: "${bgp_peer_name}"
          peerASN: ${bgp_peer_asn}
          peerAddress: ${bgp_peer_address}
          peerConfigRef:
            name: "${bgp_peer_name}-peer"
---
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: ${bgp_peer_name}-peer
spec:
  families:
    - afi: ipv4
      safi: unicast
      advertisements:
        matchLabels:
          advertise: "lb"
---
apiVersion: cilium.io/v2
kind: CiliumBGPAdvertisement
metadata:
  name: lb-advertisement
  labels:
    advertise: "lb"
spec:
  advertisements:
    - advertisementType: "Service"
      service:
        addresses:
          - LoadBalancerIP
      # match ALL LoadBalancer Services (the documented "advertise everything" idiom)
      selector:
        matchExpressions:
          - { key: somekey, operator: NotIn, values: ["never-used-value"] }
