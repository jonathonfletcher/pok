# GENERATED by tf/aws (tofu) — do not edit by hand.
# AWS nodes are private; Ansible reaches them via ProxyJump through the border (EIP).
# Node names are synthetic (cp*/w*) — the k8s node name comes from the OS hostname.

[primary_cp]
cp1 ansible_host=${cp_ips[0]}

[secondary_cp]
%{ for i in range(1, length(cp_ips)) ~}
cp${i + 1} ansible_host=${cp_ips[i]}
%{ endfor ~}

[workers]
%{ for i in range(0, length(worker_ips)) ~}
w${i + 1} ansible_host=${worker_ips[i]}
%{ endfor ~}

[control_plane:children]
primary_cp
secondary_cp

[kube_cluster:children]
control_plane
workers

[kube_cluster:vars]
ansible_ssh_common_args=-o ProxyJump=ubuntu@${border_ip} -o StrictHostKeyChecking=accept-new
