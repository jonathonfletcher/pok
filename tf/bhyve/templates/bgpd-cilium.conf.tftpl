# --- Cilium (bhyve k8s cluster) -----------------------------------------
# GENERATED by tf/bhyve (tofu) from templates/bgpd-cilium.conf.tftpl — do not hand-edit.
# The k8s-cilium peering section for the OpenBSD gateway's /etc/bgpd.conf. Append this block,
# then: bgpd -n && rcctl reload bgpd. The bhyve analogue of the AWS border's FRR config.
#
# eBGP peering: the gateway's own ASN is the global `AS ${peer_asn}` line at the top of
# bgpd.conf (set elsewhere — this block does NOT redeclare it). `remote-as` below is the
# k8s nodes' ASN (${cluster_asn}). Matches the Cilium side: peerASN ${peer_asn} / localASN ${cluster_asn}.
group k8s-cilium {
    remote-as ${cluster_asn}
%{ for name, ip in nodes ~}
    neighbor ${ip}      # ${name}
%{ endfor ~}
}

# accept ONLY the LB pool from Cilium; advertise nothing back to the nodes.
# (place AFTER the existing `allow from ibgp` lines — bgpd is last-match-wins)
allow from group k8s-cilium prefix ${lb_pool_prefix}.0/24 or-longer
deny  to   group k8s-cilium
